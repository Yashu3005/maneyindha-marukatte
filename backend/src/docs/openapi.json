{
  "openapi": "3.0.3",
  "info": {
    "title": "Maneyindha Marukatte API",
    "version": "0.3.0",
    "description": "Localized marketplace for home-based women entrepreneurs."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Envelope": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {},
          "meta": {
            "type": "object"
          },
          "error": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string"
              },
              "code": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/auth/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Register with email/phone + password",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "password"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string"
                  },
                  "phone": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 8
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "customer",
                      "entrepreneur",
                      "delivery_partner"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User + token pair"
          },
          "409": {
            "description": "Account exists"
          },
          "422": {
            "description": "Validation error"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Login with email/phone + password",
        "responses": {
          "200": {
            "description": "User + token pair"
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Rotate token pair using refresh token",
        "responses": {
          "200": {
            "description": "New token pair"
          },
          "401": {
            "description": "Invalid refresh token"
          }
        }
      }
    },
    "/auth/firebase-exchange": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Exchange Firebase ID token (phone OTP / Google / Apple) for backend JWT pair",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "idToken"
                ],
                "properties": {
                  "idToken": {
                    "type": "string"
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "customer",
                      "entrepreneur",
                      "delivery_partner"
                    ]
                  },
                  "name": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User + token pair"
          },
          "401": {
            "description": "Invalid Firebase token"
          }
        }
      }
    },
    "/businesses/nearby": {
      "get": {
        "tags": [
          "Businesses"
        ],
        "summary": "Geo search for approved businesses",
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "lng",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "radiusKm",
            "in": "query",
            "schema": {
              "type": "number",
              "default": 10
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Business list"
          }
        }
      }
    },
    "/businesses/{id}": {
      "get": {
        "tags": [
          "Businesses"
        ],
        "summary": "Business details",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Business"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/businesses": {
      "post": {
        "tags": [
          "Businesses"
        ],
        "summary": "Create business (entrepreneur only)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "Created"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      }
    },
    "/products": {
      "get": {
        "tags": [
          "Products"
        ],
        "summary": "Search/list products",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 20
            }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "-createdAt"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Product list with pagination meta"
          }
        }
      },
      "post": {
        "tags": [
          "Products"
        ],
        "summary": "Create product (owner entrepreneur only)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "Created"
          },
          "403": {
            "description": "Not your business"
          }
        }
      }
    },
    "/products/{id}": {
      "get": {
        "tags": [
          "Products"
        ],
        "summary": "Product details",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Product"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/orders": {
      "post": {
        "tags": [
          "Orders"
        ],
        "summary": "Create order (customer). Pricing computed server-side.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "businessId",
                  "items"
                ],
                "properties": {
                  "businessId": {
                    "type": "string"
                  },
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "productId": {
                          "type": "string"
                        },
                        "quantity": {
                          "type": "integer",
                          "minimum": 1
                        }
                      }
                    }
                  },
                  "deliveryAddress": {
                    "type": "object"
                  },
                  "isSelfPickup": {
                    "type": "boolean"
                  },
                  "notes": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Order created (status: pending)"
          },
          "422": {
            "description": "Stock/validation error"
          }
        }
      }
    },
    "/orders/mine": {
      "get": {
        "tags": [
          "Orders"
        ],
        "summary": "My orders (role-scoped)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Orders"
          }
        }
      }
    },
    "/orders/{id}/status": {
      "patch": {
        "tags": [
          "Orders"
        ],
        "summary": "Transition order status (state-machine validated)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "status"
                ],
                "properties": {
                  "status": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated order"
          },
          "422": {
            "description": "Invalid transition"
          }
        }
      }
    },
    "/cart": {
      "get": {
        "tags": [
          "Cart"
        ],
        "summary": "Get my cart with computed totals",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Cart"
          }
        }
      },
      "delete": {
        "tags": [
          "Cart"
        ],
        "summary": "Clear cart",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Empty cart"
          }
        }
      }
    },
    "/cart/items": {
      "post": {
        "tags": [
          "Cart"
        ],
        "summary": "Add item (different business replaces cart)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "Updated cart"
          },
          "422": {
            "description": "Insufficient stock"
          }
        }
      },
      "patch": {
        "tags": [
          "Cart"
        ],
        "summary": "Update quantity (0 removes item)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Updated cart"
          }
        }
      }
    },
    "/cart/coupon": {
      "post": {
        "tags": [
          "Cart"
        ],
        "summary": "Apply coupon (validated: window, business, min amount, usage limits)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Cart with discount"
          },
          "422": {
            "description": "Invalid/expired coupon"
          }
        }
      }
    },
    "/reviews": {
      "post": {
        "tags": [
          "Reviews"
        ],
        "summary": "Create review; orderId makes it a verified purchase (must be delivered)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "Review created, ratings recomputed"
          },
          "409": {
            "description": "Duplicate review"
          }
        }
      }
    },
    "/reviews/product/{productId}": {
      "get": {
        "tags": [
          "Reviews"
        ],
        "summary": "List reviews for a product",
        "parameters": [
          {
            "name": "productId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Reviews"
          }
        }
      }
    },
    "/reviews/{id}/reply": {
      "post": {
        "tags": [
          "Reviews"
        ],
        "summary": "Entrepreneur reply (own business only)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Review with reply"
          },
          "403": {
            "description": "Not your business"
          }
        }
      }
    },
    "/wishlist": {
      "get": {
        "tags": [
          "Wishlist"
        ],
        "summary": "Get wishlist (products + followed shops)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Wishlist"
          }
        }
      }
    },
    "/wishlist/products": {
      "post": {
        "tags": [
          "Wishlist"
        ],
        "summary": "Toggle product in wishlist",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "{ inWishlist }"
          }
        }
      }
    },
    "/wishlist/businesses": {
      "post": {
        "tags": [
          "Wishlist"
        ],
        "summary": "Toggle follow business",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "{ following }"
          }
        }
      }
    },
    "/businesses/{id}/verification-documents": {
      "post": {
        "tags": [
          "Businesses"
        ],
        "summary": "Submit verification documents (status → in_review)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Business"
          }
        }
      }
    },
    "/admin/verifications": {
      "get": {
        "tags": [
          "Admin"
        ],
        "summary": "List verification requests by status",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "pending",
                "in_review",
                "approved",
                "rejected"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Businesses"
          }
        }
      }
    },
    "/admin/verifications/{businessId}": {
      "post": {
        "tags": [
          "Admin"
        ],
        "summary": "Approve / reject / request_info (notifies owner)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "businessId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Business"
          },
          "422": {
            "description": "Already reviewed / missing reason"
          }
        }
      }
    }
  }
}