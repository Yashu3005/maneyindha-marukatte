# =====================================================================================
# Copy to .env (repo root or backend/) and fill in. NEVER commit real values.
# Every value below is a placeholder. Names marked (required) stop the API from starting if missing.
# =====================================================================================

# ---------- Core ----------
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000/api/v1
# Comma-separated list of allowed browser origins (REST + Socket.IO). Unset = allow all (dev only!).
CORS_ORIGINS=
# Reverse-proxy hops to trust for client IPs / rate limiting. Defaults to 1 when NODE_ENV=production.
TRUST_PROXY=
LOG_LEVEL=info

# ---------- Database ----------
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/maneyindha?retryWrites=true&w=majority   # (required)
REDIS_URL=redis://localhost:6379

# ---------- Auth ----------
JWT_SECRET=replace-with-long-random-string                    # (required) 32+ chars in production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-another-long-random-string    # (required) must differ from JWT_SECRET
JWT_REFRESH_EXPIRES_IN=30d
# Key for hashing one-time codes. Optional: falls back to JWT_SECRET. Set a separate random value in production.
OTP_HMAC_SECRET=

# ---------- Email OTP — required in production ----------
# Provider: resend (default) | brevo. Fill in the section for the one you choose.
EMAIL_PROVIDER=resend

# --- Resend ---
# Create a key in the Resend dashboard. Sending needs a VERIFIED DOMAIN (resend.com/domains);
# a Gmail/Yahoo/Outlook address cannot be the sender and the API refuses to start in production with one.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Format: Display Name <address@your-verified-domain>
# Local testing only: Maneyindha Marukatte <onboarding@resend.dev> (Resend delivers that only to your own account email).
RESEND_FROM_EMAIL=Maneyindha Marukatte <login@mail.your-domain.example>

# --- Brevo (EMAIL_PROVIDER=brevo): REST API key (starts xkeysib-) from Brevo -> SMTP & API -> API Keys.
# The sender must be verified in Brevo (Senders, Domains & Dedicated IPs -> Senders); no domain is needed for a single verified sender.
BREVO_API_KEY=
BREVO_FROM_EMAIL=Maneyindha Marukatte <your-verified-sender@example.com>

# ---------- Payments (Razorpay) — use TEST-mode keys until you deliberately go live ----------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
# The secret you type when creating the webhook in the Razorpay dashboard (not the key secret).
RAZORPAY_WEBHOOK_SECRET=

# ---------- AI ----------
AI_PROVIDER=gemini            # gemini | openai
GEMINI_API_KEY=
GEMINI_MODEL=                 # optional; defaults to the model named in backend/src/ai/providers/gemini.js. Set a currently available model.
OPENAI_API_KEY=
OPENAI_MODEL=                 # optional; defaults to gpt-4o-mini
AI_TIMEOUT_MS=20000

# ---------- Media (profile photos) ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
PEXELS_API_KEY=               # optional stock-photo suggestions for product pictures

# ---------- App download QR (landing screen) ----------
# Public https destination only. Leave all empty to hide the QR. Priority: DOWNLOAD > ANDROID > IOS > WEB.
# Only set a store URL after the listing really exists; the QR encodes exactly what you put here.
APP_DOWNLOAD_URL=
APP_ANDROID_URL=
APP_IOS_URL=
APP_WEB_URL=

# ---------- Firebase (optional legacy sign-in exchange) ----------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---------- Maps ----------
# Not used by the current code (location uses the device GPS and the app's own distance maths).
GOOGLE_MAPS_API_KEY=
