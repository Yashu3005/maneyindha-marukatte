# ---------- Core ----------
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000/api/v1
# Comma-separated list of allowed browser origins (REST + Socket.IO). Unset = allow all (dev only!).
CORS_ORIGINS=
# Reverse-proxy hops to trust for client IPs / rate limiting. Defaults to 1 when NODE_ENV=production.
TRUST_PROXY=

# ---------- Database ----------
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/maneyindha?retryWrites=true&w=majority
REDIS_URL=redis://localhost:6379

# ---------- Auth ----------
JWT_SECRET=replace-with-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-another-long-random-string
JWT_REFRESH_EXPIRES_IN=30d
# DEV ONLY: lets the fixed demo OTP (029403) log in without an email provider.
# Ignored when NODE_ENV=production. Leave unset/false anywhere real users exist.
ALLOW_DEMO_OTP=true

# ---------- Firebase ----------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---------- Payments (Razorpay) ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------- Maps ----------
GOOGLE_MAPS_API_KEY=

# ---------- Media ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- AI ----------
AI_PROVIDER=gemini            # gemini | openai
OPENAI_API_KEY=
GEMINI_API_KEY=

# ---------- Images ----------
PEXELS_API_KEY=
